<!DOCTYPE html>
<html lang="en">
<head>
    <title>Investor Dashboard</title>
    <link rel="stylesheet" href="/css/investor.css">
    <script src="http://localhost:3000/socket.io/socket.io.js"></script>
</head>
<body>
    <h1>Investor Dashboard</h1>
    
    <!-- Example Startup -->
    <!-- <div>
        <h3>Startup ABC</h3>
        <button onclick="startChat('investor_123', 'startup_456')">Chat</button>
    </div> -->

    <div class="startup-card">
        <h3>Startup ABC</h3>
        <p class="startup-info">👥 Team Members: 10</p>
        <p class="startup-info">💰 Funding Required: $500,000</p>
        <p class="startup-info">📌 Description: A startup focused on AI-driven automation in the finance sector.</p>
        
        <div class="card-buttons">
            <button class="chat-btn" onclick="startChat('investor_123', 'startup_456')">Chat</button>
            <button class="ai-btn">AI Q&A</button>
        </div>
    </div>

    <div id="chatBox" style="display:none;">
        <h2>Chat Room</h2>
        <div id="messages"></div>
        <input type="text" id="messageInput" placeholder="Type a message">
        <button id="sendButton">Send</button>
    </div>
    <div id="overlay" onclick="closeChat()"></div>


    <script>
        const socket = io("http://localhost:3000");
        let chatId = "";

        function startChat(investorId, startupId) {
            chatId = `${investorId}_${startupId}`;
            socket.emit("startChat", { investorId, startupId });
            document.getElementById("chatBox").style.display = "block";
            const overlay = document.getElementById("overlay");
            overlay.style.display= "block";
            setTimeout(() => {
            overlay.style.background = "rgba(0, 0, 0, 0.3)";
            overlay.style.backdropFilter = "blur(5px)"; // Apply blur smoothly
        }, 10); 
        }

        socket.on("chatActive", ({ chatId }) => {
            console.log("Chat active:", chatId);
        });

        // function sendMessage() {
        //     const message = document.getElementById("messageInput").value;
        //     socket.emit("sendMessage", { chatId, sender: "Investor", message });
        //     document.getElementById("messageInput").value = "";
        // }

        document.getElementById("sendButton").addEventListener("click", function () {
            const message = document.getElementById("messageInput").value;
            console.log("Sending message:", message); // Debugging log

            socket.emit("sendMessage", { chatId, sender: "Investor", message });
            console.log(`i have sent chatid : ${chatId}`);
            document.getElementById("messageInput").value = "";
        });


        // socket.on("receiveMessage", ({ sender, message }) => {
        //     document.getElementById("messages").innerHTML += `<p><b>${sender}:</b> ${message}</p>`;
        // });

        socket.on("receiveMessage", ({ sender, message }) => {
            console.log("New message received:", message); // Debugging log

            const Messages = document.getElementById("messages");
            const msgElement = document.createElement("p");
            if(sender === "Investor"){
                msgElement.innerText = `me: ${message}`;
            }else{
                msgElement.innerText = `${sender}: ${message}`;
            }
            
            Messages.appendChild(msgElement);
        });
    </script>
</body>
</html>
