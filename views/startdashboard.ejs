<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Startup Dashboard | InnovaConnect</title>
   <link rel="stylesheet" href="/css/startdashboard.css">
</head>
<body>

    <div class="sidebar">
        <h2>Startup Dashboard</h2>
        <ul>
            <li onclick="showContent('overview')">📊 Overview</li>
            <li onclick="showContent('funding')">💰 Funding Progress</li>
            <li onclick="showContent('projects')">🚀 My Projects</li>
            <li onclick="showContent('network')">🤝 Connect with Investors</li>
            <li onclick="showContent('settings')">⚙️ Settings</li>
        </ul>
    </div>

    <div class="content">
        <div class="header">Welcome, Startup Owner!</div>
        <div class="dashboard-info" id="dashboard-content">
            <div class="card">
                <h3>📊 Overview</h3>
                <p>Track your startup's progress, funding, and connections.</p>
            </div>
        </div>
    </div>

    <script>
        function showContent(section) {
            let content = {
                overview: "<h3>📊 Overview</h3><p>Track your startup's progress, funding, and connections.</p>",
                funding: "<h3>💰 Funding Progress</h3><p>Current Funding: $50,000 / $200,000</p>",
                projects: "<h3>🚀 My Projects</h3><p>Manage your startup projects and milestones.</p>",
                network: "<h3>🤝 Connect with Investors</h3><p>Find investors who are interested in your startup.</p>",
                settings: "<h3>⚙️ Settings</h3><p>Manage your startup profile and security settings.</p>"
            };
            document.getElementById("dashboard-content").innerHTML = `<div class="card">${content[section]}</div>`;
        }
    </script>

</body>
</html>
